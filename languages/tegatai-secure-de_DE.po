msgstr "Pro Zeile ein Regex (z.B. <code>/bad-bot/i</code>)."

#: includes/admin.php:1052
msgid "IP Lists"
msgstr "IP Listen"

#: includes/admin.php:1052
msgid "Whitelist IPs"
msgstr "Whitelist IPs"

#: includes/admin.php:1052
msgid "Blacklist IPs"
msgstr "Blacklist IPs"

