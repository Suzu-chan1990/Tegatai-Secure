#: includes/admin.php:407
#, php-format
msgid "%s is set (secrets file / wp-config.php)."
msgstr "%s ist gesetzt (Schlüsseldatei / wp-config.php)."

#. translators: %s: constant name
#: includes/admin.php:411
#, php-format
msgid ""
"Still stored in the database by an older version. Move it into the secrets "
"file as %s (command in the Secrets tab); it is then deleted from the "
"database."
msgstr ""
"Noch von einer älteren Version in der Datenbank gespeichert. Übertrage es "
"als %s in die Schlüsseldatei (Befehl im Tab Secrets); danach wird es aus der"
" Datenbank gelöscht."

#. translators: %s: constant name
#: includes/admin.php:414
#, php-format
msgid ""
"Not set. Secrets are never stored in the database: add %s to the secrets "
"file (Secrets tab)."
msgstr ""
"Nicht gesetzt. Secrets werden nie in der Datenbank gespeichert: trage %s in "
"die Schlüsseldatei ein (Tab Secrets)."

