msgid "Enforces strict HTTPS connections."
msgstr "Erzwingt strikte HTTPS-Verbindungen."

#: includes/admin.php:1109
msgid "HSTS: include subdomains"
msgstr "HSTS: Subdomains einschließen"

#: includes/admin.php:1109
msgid ""
"Only enable if ALL subdomains are reachable via HTTPS, otherwise they become"
" unreachable for a year."
msgstr ""
"Nur aktivieren, wenn ALLE Subdomains per HTTPS erreichbar sind – sonst sind "
"sie ein Jahr lang nicht erreichbar."

#: includes/admin.php:1109
msgid "Referrer Policy"
msgstr "Referrer Policy"

#: includes/admin.php:1109
msgid "Controls referrer information."
msgstr "Steuert die Referrer-Informationen."

