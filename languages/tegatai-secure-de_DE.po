#: includes/admin.php:1052
msgid "Allowed URLs"
msgstr "Erlaubte URLs"

#: includes/admin.php:1052
msgid "Custom Rules"
msgstr "Eigene Regeln"

#: includes/admin.php:1052
msgid "Custom Regex Filters"
msgstr "Eigene Regex Filter"

#: includes/admin.php:1052
