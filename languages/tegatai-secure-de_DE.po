msgstr "Verhindert, dass Angreifer Dateilisten deines Servers sehen können."

#: includes/admin.php:1054
msgid "Protect Sensitive Files"
msgstr "Sensible Dateien schützen"

#: includes/admin.php:1054
msgid "Blocks access to .env, .sql, .bak, .log, and .git files."
msgstr "Blockiert den Zugriff auf .env, .sql, .bak, .log und .git Dateien."

#: includes/admin.php:1054
msgid "Block System Files"
msgstr "Systemdateien blockieren"

#: includes/admin.php:1054
msgid "Hides readme.html, license.txt, and wp-config.php from the web."
msgstr "Versteckt readme.html, license.txt und wp-config.php vor dem Web."

#: includes/admin.php:1054
msgid "Block Dotfiles"
msgstr "Dotfiles blockieren"

#: includes/admin.php:1054
msgid "Denies access to hidden files (e.g., .htaccess)."
msgstr "Verweigert den Zugriff auf versteckte Dateien (z.B. .htaccess)."

#: includes/admin.php:1054
msgid "Block XML-RPC"
msgstr "XML-RPC blockieren"

#: includes/admin.php:1054
msgid "Disables xmlrpc.php to prevent DDoS and brute-force attacks."
msgstr ""
"Deaktiviert die xmlrpc.php, um DDoS- und Brute-Force-Angriffe zu verhindern."

#: includes/admin.php:1054
msgid "Disable PHP in Uploads"
msgstr "PHP in Uploads deaktivieren"

#: includes/admin.php:1054
msgid "Prevents execution of malicious backdoors in your media folder."
msgstr ""
"Verhindert die Ausführung von Malware und Backdoors in deinem Upload-Ordner."

#: includes/admin.php:1054
msgid "Allow direct PHP in Plugins & Themes"
msgstr "Direktes PHP in Plugins & Themes erlauben"

#: includes/admin.php:1054
msgid ""
"Off (recommended): direct requests for PHP files in plugins and themes are "
"blocked, except the files under \"PHP Exceptions\". Switch on only if a "
"plugin still fails because of this."
msgstr ""
"Aus (empfohlen): Direkte Aufrufe von PHP-Dateien in Plugins und Themes "
"werden blockiert, außer den Dateien unter „PHP-Ausnahmen“. Nur einschalten, "
"wenn ein Plugin deswegen trotzdem nicht funktioniert."

#: includes/admin.php:1054
msgid "Ultimate Bad Bot Filter"
msgstr "Ultimate Bad Bot Filter"

#: includes/admin.php:1054
msgid ""
"Blocks hacking tools, AI scrapers and SEO crawlers on the web server (nginx "
"file or .htaccess)."
msgstr ""
"Blockiert Hacking-Tools, KI-Scraper und SEO-Crawler direkt auf dem Webserver"
" (nginx-Datei oder .htaccess)."

#: includes/admin.php:1054
msgid "Hotlink Protection"
msgstr "Hotlink Schutz"

#: includes/admin.php:1054
msgid ""
"Prevents other sites from embedding your images and stealing bandwidth."
msgstr ""
"Verhindert, dass andere Seiten deine Bilder einbetten und Bandbreite "
"stehlen."

#: includes/admin.php:1054
